            event.style.left = '0px';
            event.style.width = `${dayWidth * rowDays.length}px`;
            event.style.borderRadius = '6px';
            
            event.addEventListener('click', (e) => {
              e.stopPropagation();
              e.preventDefault();
              this.editEvent('maintenance', m);
