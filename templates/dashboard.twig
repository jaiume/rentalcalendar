            maintenanceRow.appendChild(event);
            
            // Mark days in this row to not render this event again
            rowDays.forEach(day => {
              renderedEvents.add(`maintenance-${m.property_maintenance_id}-${day.dateStr}`);
            });
          });
        } else if (!isMultiDay) {
          // Single day event
          const event = document.createElement('div');
