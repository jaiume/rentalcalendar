{% extends "portals/maravalroad/guest_layout.twig" %}

{% block title %}{{ portal.name }} – Guest services{% endblock %}

{% block content %}
    <p class="text-muted mb-3">Choose a service below.</p>
    <div class="row g-3">
        {% if portal.laundry_enabled %}
            <div class="col-12">
                <a href="/laundry" class="card portal-card text-decoration-none text-reset">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="h5 mb-1">Laundry access</h3>
                            <p class="text-muted small mb-0">
                                Pay once and we'll show you the padlock combination and instructions.
                            </p>
                        </div>
                        <span class="text-primary fw-semibold">Open &raquo;</span>
                    </div>
                </a>
            </div>
        {% endif %}

        {% if portal.supplies_enabled %}
            <div class="col-12">
                <a href="/supplies" class="card portal-card text-decoration-none text-reset">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="h5 mb-1">Request supplies</h3>
                            <p class="text-muted small mb-0">
                                Out of towels, sheets, toilet paper? Let us know.
                            </p>
                        </div>
                        <span class="text-primary fw-semibold">Open &raquo;</span>
                    </div>
                </a>
            </div>
        {% endif %}

        {% if not portal.laundry_enabled and not portal.supplies_enabled %}
            <div class="col-12">
                <div class="alert alert-info mb-0">
                    No services are currently available. Please contact your host.
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
