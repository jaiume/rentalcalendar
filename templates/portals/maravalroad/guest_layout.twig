<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    <title>{% block title %}{{ portal.name }}{% endblock %}</title>
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous">
    <style>
        :root { color-scheme: light; }
        body { background: #f8f9fa; }
        .portal-header {
            background: #1f2937;
            color: #fff;
            padding: 1rem 0;
        }
        .portal-header .portal-logo {
            max-height: 56px;
            width: auto;
            display: block;
        }
        .portal-card {
            border: 0;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.05);
        }
        .portal-card .card-body { padding: 1.5rem; }
        .portal-footer {
            color: #6c757d;
            font-size: 0.875rem;
            padding: 1.5rem 0;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="portal-header">
        <div class="container d-flex align-items-center gap-3">
            {% if portal.logo_url %}
                <img src="{{ portal.logo_url }}" alt="{{ portal.name }}" class="portal-logo">
            {% endif %}
            <div>
                <h1 class="h4 mb-0">{{ portal.name }}</h1>
                {% if portal.tagline %}
                    <small class="text-white-50">{{ portal.tagline }}</small>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="container py-4 flex-grow-1">
        {% block content %}{% endblock %}
    </main>

    <footer class="portal-footer text-center">
        <div class="container">
            &copy; {{ "now"|date("Y") }} {{ portal.name }}
        </div>
    </footer>

    {% block scripts %}{% endblock %}
</body>
</html>
