{% extends "layout.twig" %}

{% block title %}Supply Requests | Admin{% endblock %}

{% block content %}
  <section class="py-5">
    <div class="container">
      <div class="row mb-4">
        <div class="col-12">
          <h1 class="h2 mb-0">Supply Requests</h1>
          <p class="text-muted mb-0">Guest-submitted supply requests for the configured portal groups.</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <form method="get" action="/admin/supply-requests" class="row g-2 align-items-end">
            <div class="col-md-3">
              <label for="portal_group_id" class="form-label">Portal group</label>
              <select id="portal_group_id" name="portal_group_id" class="form-select">
                <option value="">All</option>
                {% for pg in portal_groups %}
                  <option value="{{ pg.portal_group_id }}" {% if filters.portal_group_id is defined and filters.portal_group_id == pg.portal_group_id %}selected{% endif %}>
                    {{ pg.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-3">
              <label for="status" class="form-label">Status</label>
              <select id="status" name="status" class="form-select">
                <option value="">All</option>
                {% for s in statuses %}
                  <option value="{{ s }}" {% if filters.status is defined and filters.status == s %}selected{% endif %}>{{ s }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="from" class="form-label">From</label>
              <input type="date" id="from" name="from" class="form-control" value="{{ filters.from|default('') }}">
            </div>
            <div class="col-md-2">
              <label for="to" class="form-label">To</label>
              <input type="date" id="to" name="to" class="form-control" value="{{ filters.to|default('') }}">
            </div>
            <div class="col-md-2 d-grid">
              <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          {% if supply_requests|length > 0 %}
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Created</th>
                    <th>Portal group</th>
                    <th>Property</th>
                    <th>Request</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {% for sr in supply_requests %}
                    <tr>
                      <td><small>{{ sr.created_at }}</small></td>
                      <td>{{ sr.portal_group_name }}</td>
                      <td>{{ sr.property_name }}</td>
                      <td><pre class="mb-0 small" style="white-space: pre-wrap;">{{ sr.request_text }}</pre></td>
                      <td>
                        <span class="badge bg-{% if sr.status == 'pending' %}warning{% elseif sr.status == 'fulfilled' %}success{% elseif sr.status == 'cancelled' %}secondary{% else %}info{% endif %}">{{ sr.status }}</span>
                      </td>
                      <td>
                        <form method="post" action="/admin/supply-requests/{{ sr.supply_request_id }}/status" class="d-flex gap-1">
                          <select name="status" class="form-select form-select-sm">
                            {% for s in statuses %}
                              <option value="{{ s }}" {% if s == sr.status %}selected{% endif %}>{{ s }}</option>
                            {% endfor %}
                          </select>
                          <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p class="text-muted mb-0">No supply requests match the current filters.</p>
          {% endif %}
        </div>
      </div>

      <div class="mt-3">
        <a href="/admin" class="text-decoration-none">← Back to Admin Dashboard</a>
      </div>
    </div>
  </section>
{% endblock %}
