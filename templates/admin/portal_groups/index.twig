{% extends "layout.twig" %}

{% block title %}Portal Groups | Admin{% endblock %}

{% block content %}
  <section class="py-5">
    <div class="container">
      <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
          <div>
            <h1 class="h2 mb-0">Portal Groups</h1>
            <p class="text-muted mb-0">Hostname-routed guest portals and the properties that belong to them.</p>
          </div>
          <a href="/admin/portal-groups/create" class="btn btn-primary">Add Portal Group</a>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          {% if portal_groups|length > 0 %}
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Guest hostname</th>
                    <th class="text-center">Properties</th>
                    <th>Config file</th>
                    <th class="text-center">Active</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for pg in portal_groups %}
                    <tr>
                      <td>{{ pg.name }}</td>
                      <td><code>{{ pg.slug }}</code></td>
                      <td>{% if pg.guest_hostname %}<code>{{ pg.guest_hostname }}</code>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                      <td class="text-center">{{ pg.property_count }}</td>
                      <td>
                        {% if pg.config_status.exists %}
                          <span class="text-success small">config/portals/{{ pg.slug }}.php</span>
                        {% else %}
                          <span class="text-danger small">{{ pg.config_status.error }}</span>
                        {% endif %}
                      </td>
                      <td class="text-center">
                        {% if pg.is_active %}
                          <span class="badge bg-success">Active</span>
                        {% else %}
                          <span class="badge bg-secondary">Inactive</span>
                        {% endif %}
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <a href="/admin/portal-groups/{{ pg.portal_group_id }}/edit" class="btn btn-outline-primary">Edit</a>
                          <a href="/admin/portal-groups/{{ pg.portal_group_id }}/delete" class="btn btn-outline-danger" onclick="return confirm('Delete this portal group? Properties stay; this only removes the portal mapping.')">Delete</a>
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p class="text-muted mb-0">No portal groups yet. <a href="/admin/portal-groups/create">Create one</a>.</p>
          {% endif %}
        </div>
      </div>

      <div class="mt-3">
        <a href="/admin" class="text-decoration-none">← Back to Admin Dashboard</a>
      </div>
    </div>
  </section>
{% endblock %}
