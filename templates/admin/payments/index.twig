{% extends "layout.twig" %}

{% block title %}Payments | Admin{% endblock %}

{% block content %}
  <section class="py-5">
    <div class="container">
      <div class="row mb-4">
        <div class="col-12">
          <h1 class="h2 mb-0">Payments</h1>
          <p class="text-muted mb-0">PayPal payments captured by guest portals (laundry access today; future paid services slot in here too).</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <form method="get" action="/admin/payments" class="row g-2 align-items-end">
            <div class="col-md-3">
              <label for="portal_group_id" class="form-label">Portal group</label>
              <select id="portal_group_id" name="portal_group_id" class="form-select">
                <option value="">All</option>
                {% for pg in portal_groups %}
                  <option value="{{ pg.portal_group_id }}" {% if filters.portal_group_id is defined and filters.portal_group_id == pg.portal_group_id %}selected{% endif %}>
                    {{ pg.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="item_type" class="form-label">Item</label>
              <select id="item_type" name="item_type" class="form-select">
                <option value="">All</option>
                {% for it in item_types %}
                  <option value="{{ it }}" {% if filters.item_type is defined and filters.item_type == it %}selected{% endif %}>{{ it }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="status" class="form-label">Status</label>
              <select id="status" name="status" class="form-select">
                <option value="">All</option>
                {% for s in statuses %}
                  <option value="{{ s }}" {% if filters.status is defined and filters.status == s %}selected{% endif %}>{{ s }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-2">
              <label for="from" class="form-label">From</label>
              <input type="date" id="from" name="from" class="form-control" value="{{ filters.from|default('') }}">
            </div>
            <div class="col-md-2">
              <label for="to" class="form-label">To</label>
              <input type="date" id="to" name="to" class="form-control" value="{{ filters.to|default('') }}">
            </div>
            <div class="col-md-1 d-grid">
              <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          {% if payments|length > 0 %}
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead>
                  <tr>
                    <th>Created</th>
                    <th>Portal group</th>
                    <th>Item</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>PayPal order</th>
                    <th>Payer</th>
                  </tr>
                </thead>
                <tbody>
                  {% for p in payments %}
                    <tr>
                      <td><small>{{ p.created_at }}</small></td>
                      <td>{{ p.portal_group_name }}</td>
                      <td><code>{{ p.item_type }}</code>{% if p.item_reference %} <small class="text-muted">#{{ p.item_reference }}</small>{% endif %}</td>
                      <td>{{ p.description }}</td>
                      <td>{{ p.currency }} {{ (p.amount_cents / 100)|number_format(2) }}</td>
                      <td>
                        <span class="badge bg-{% if p.status == 'completed' %}success{% elseif p.status == 'failed' %}danger{% elseif p.status == 'refunded' %}secondary{% else %}info{% endif %}">{{ p.status }}</span>
                      </td>
                      <td><code class="small">{{ p.paypal_order_id|default('—') }}</code></td>
                      <td><small>{{ p.payer_email|default('—') }}</small></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p class="text-muted mb-0">No payments match the current filters.</p>
          {% endif %}
        </div>
      </div>

      <div class="mt-3">
        <a href="/admin" class="text-decoration-none">← Back to Admin Dashboard</a>
      </div>
    </div>
  </section>
{% endblock %}
